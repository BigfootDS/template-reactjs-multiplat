{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["react"],
  "ignorePatterns": [
    "dist",
    "dist-electron",
    "playwright-report",
    "test-results"
  ],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/only-export-components": ["error", { "allowConstantExport": true }]
  }
}
