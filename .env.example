# Copy this file with `npm run setup:env`, then keep the values in .env.local.
# Do not use the VITE_ prefix for signing values. Vite exposes that prefix to web code.

# Use an absolute path or a path relative to the repository root. Keep the keystore outside this repository.
ANDROID_SIGNING_STORE_FILE=
ANDROID_SIGNING_STORE_PASSWORD=
ANDROID_SIGNING_KEY_ALIAS=
ANDROID_SIGNING_KEY_PASSWORD=

# Optional. JKS is the usual Java keystore format. Use PKCS12 only when the selected keystore needs it.
ANDROID_SIGNING_STORE_TYPE=JKS
